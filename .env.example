EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public enrollment/payment display values. Do not put passwords, PINs, OTPs,
# private API keys, or Supabase service-role credentials in EXPO_PUBLIC variables.
EXPO_PUBLIC_PAYMENT_BANK_NAME=Your bank name
EXPO_PUBLIC_PAYMENT_ACCOUNT_NAME=Your account name
EXPO_PUBLIC_PAYMENT_ACCOUNT_NUMBER=Your account number
EXPO_PUBLIC_PAYMENT_WHATSAPP_NUMBER=2348000000000

# Public support address shown in the mobile app.
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
